# Coffee Cabs Environment Configuration Example
# Copy this file to .env.local for local overrides. Never commit secrets to source control.

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Base Production Site URL (Default: https://gagangowdap.github.io/coffee-cabs)
VITE_SITE_URL=https://gagangowdap.github.io/coffee-cabs
